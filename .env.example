# YouTrack instance URL (e.g. https://yourcompany.youtrack.cloud)
YOUTRACK_URL=

# YouTrack API token (Profile -> Account Security -> New permanent token)
# Required scopes: Read Issue, Update Issue, Add Comment
YOUTRACK_TOKEN=

# Bound YouTrack project short name (single-project per instance), e.g. EL3
YOUTRACK_PROJECT=

# Path to the source repository whose diffs will be analyzed
REPO_PATH=

# Anthropic API key from https://console.anthropic.com/
# NOT a claude.ai subscription token — pay-per-token API key
ANTHROPIC_API_KEY=
